generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Таблиці які вимагає NextAuth — не чіпай їх структуру
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("student")  // student | teacher | admin
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  deletedAt     DateTime? // soft-delete — історія (Result/Source) лишається

  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])

  accounts        Account[]
  sessions        Session[]
  results         Result[]        // зв'язок з результатами
  sources         Source[]
  studentClasses  ClassStudent[]  @relation("StudentClasses")
  teacherClasses  ClassTeacher[]  @relation("TeacherClasses")
  invitesSent     Invite[]        @relation("InvitesSent")

  @@index([schoolId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Школа — корінь мультитенантності. Кожен User/Class/Invite належить одній школі.
model School {
  id        String   @id @default(cuid())
  name      String
  city      String?
  createdAt DateTime @default(now())

  users   User[]
  classes Class[]
  invites Invite[]
  results Result[]
}

// Клас школи (напр. "7-А")
model Class {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())

  students    ClassStudent[]
  teachers    ClassTeacher[]
  assignments LessonAssignment[]

  @@unique([schoolId, label])
  @@index([schoolId])
}

// Учень у класі
model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StudentClasses", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

// Вчитель, що веде клас
model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TeacherClasses", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

// Запрошення в школу — єдиний спосіб отримати роль teacher/admin/student
model Invite {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email       String
  role        String    // teacher | student | admin
  classIds    String    @default("[]") // JSON-масив id класів (учень — один, вчитель — декілька)
  token       String    @unique @default(cuid())
  status      String    @default("pending") // pending | accepted
  sentAt      DateTime  @default(now())
  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([schoolId])
  @@index([email])
}

// Призначення уроку класу або конкретним учням класу
model LessonAssignment {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     DbLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  mode       String   // all | individual
  studentIds String   @default("[]") // JSON-масив userId, використовується коли mode = individual
  createdAt  DateTime @default(now())

  @@index([classId])
  @@index([lessonId])
}

// Наша таблиця — додаємо userId
model Result {
  id          String   @id @default(cuid())
  lessonId    String
  score       Int
  total       Int
  createdAt   DateTime @default(now())
  userId      String?              // хто проходив (опціонально поки)
  user        User?    @relation(fields: [userId], references: [id])
  answersJson String?              // JSON-масив {questionId, chosenIndex, correct} для деталізованого звіту
  schoolId    String?              // денормалізовано для швидкої вибірки "результати школи"
  school      School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([lessonId])
}

model Source {
  id        String     @id @default(cuid())
  title     String
  content   String
  subjectId String
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons   DbLesson[]
}

model DbLesson {
  id              String       @id @default(cuid())
  subjectId       String
  title           String
  desc            String
  icon            String       @default("📝")
  xp              Int          @default(50)
  contentJson     String       // JSON array of theoretical blocks
  presentationUrl String?
  sourceId        String
  source          Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  questions       DbQuestion[]
  assignments     LessonAssignment[]
  createdAt       DateTime     @default(now())
}

model DbQuestion {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       DbLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text         String
  optionsJson  String   // JSON string array
  correct      Int
  explanation  String
  createdAt    DateTime @default(now())
}